          "region": "asia-southeast1"
        }
      },
      {
        "source": "/khai-thue/.well-known/**",
        "function": {
          "functionId": "khaithue",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/khai-thue/telegram/**",
        "function": {
          "functionId": "khaithue",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource/khai-thue/**",
