      },
      {
        "source": "/lich-giang/cron/**",
        "function": {
          "functionId": "antoan",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource/lich-giang/**",
        "function": {
          "functionId": "antoan",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/.well-known/oauth-authorization-server/lich-giang",
        "function": {
          "functionId": "antoan",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/.well-known/openid-configuration/lich-giang",
        "function": {
          "functionId": "antoan",
          "region": "asia-southeast1"
        }
      },
