        "function": {
          "functionId": "khaithue",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/.well-known/openid-configuration/khai-thue",
        "function": {
          "functionId": "khaithue",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/quy-phong/mcp",
        "function": {
          "functionId": "quyphong",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/quy-phong/oauth/**",
        "function": {
          "functionId": "quyphong",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/quy-phong/.well-known/**",
        "function": {
          "functionId": "quyphong",
