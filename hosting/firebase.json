{
  "hosting": {
    "site": "app-by-lethanh",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "/hoa-don/mcp",
        "function": {
          "functionId": "hoadon",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/hoa-don/oauth/**",
        "function": {
          "functionId": "hoadon",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/hoa-don/.well-known/**",
        "function": {
          "functionId": "hoadon",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/hoa-don/telegram/**",
        "function": {
          "functionId": "hoadon",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource/hoa-don/**",
        "function": {
          "functionId": "hoadon",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/.well-known/oauth-authorization-server/hoa-don",
        "function": {
          "functionId": "hoadon",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/.well-known/openid-configuration/hoa-don",
        "function": {
          "functionId": "hoadon",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/khai-thue/mcp",
        "function": {
          "functionId": "khaithue",
          "region": "asia-southeast1"
        }
      },
      {
