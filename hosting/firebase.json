      {
        "source": "/tuong-ot/.well-known/**",
        "function": {
          "functionId": "tuongotsi",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource/tuong-ot/**",
        "function": {
          "functionId": "tuongotsi",
          "region": "asia-southeast1"
        }
