        }
      },
      {
        "source": "/the-visa/mcp",
        "function": {
          "functionId": "thevisa",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/the-visa/oauth/**",
        "function": {
          "functionId": "thevisa",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/the-visa/.well-known/**",
        "function": {
          "functionId": "thevisa",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/the-visa/api/**",
        "function": {
          "functionId": "thevisa",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource/the-visa/**",
        "function": {
          "functionId": "thevisa",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/.well-known/oauth-authorization-server/the-visa",
        "function": {
          "functionId": "thevisa",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/.well-known/openid-configuration/the-visa",
        "function": {
          "functionId": "thevisa",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/hoa-don/**",
        "destination": "/hoa-don/index.html"
      },
      {
        "source": "/khai-thue/**",
        "destination": "/khai-thue/index.html"
      },
      {
        "source": "/quy-phong/**",
        "destination": "/quy-phong/index.html"
      },
      {
        "source": "/lich-giang/**",
        "destination": "/lich-giang/index.html"
      },
      {
        "source": "/tuong-ot/**",
        "destination": "/tuong-ot/index.html"
      },
      {
        "source": "/the-visa/**",
        "destination": "/the-visa/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "regex": "^/([a-z-]+/)?(index\\.html)?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "regex": "^/khai-thue/(index\\.html)?$",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'self' 'unsafe-inline' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://firestore.googleapis.com https://firebasestorage.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://apis.google.com; frame-src https://app-from-ai.firebaseapp.com https://accounts.google.com; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "lethanh",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ],
  "emulators": {
    "hosting": {
      "port": 5050
    },
    "functions": {
      "port": 5051
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
