# Chép file này thành .env rồi điền. Để trống = chạy chế độ thử (lưu trên trình duyệt).
# (Cấu hình web Firebase không phải mật khẩu — bảo vệ dữ liệu nằm ở firestore.rules.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Database riêng của app này trong project app-from-ai (KHÔNG dùng (default))
VITE_FIREBASE_DATABASE_ID=

# Email chủ shop được xem/sửa, cách nhau dấu phẩy. Phải khớp firestore.rules.
VITE_ADMIN_EMAILS=vietthanh228@gmail.com
