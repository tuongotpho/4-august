{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/telegram/:buoc",
      "destination": "/api/index?duong=/telegram/:buoc"
    },
    {
      "source": "/ai/:buoc",
      "destination": "/api/index?duong=/ai/:buoc"
    },
    {
      "source": "/cron/:buoc",
      "destination": "/api/index?duong=/cron/:buoc"
    },
    {
      "source": "/mcp",
      "destination": "/api/index?duong=/mcp"
    },
    {
      "source": "/oauth/:buoc",
      "destination": "/api/index?duong=/oauth/:buoc"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/index?duong=/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:p*",
      "destination": "/api/index?duong=/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/index?duong=/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:p*",
      "destination": "/api/index?duong=/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/index?duong=/.well-known/openid-configuration"
    }
  ],
  "crons": [
    {
      "path": "/cron/nhac",
      "schedule": "0 13 * * *"
    }
  ]
}