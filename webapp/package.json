{
  "name": "quan-ly-quy-ktat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && tsc -p tsconfig.mcp.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:emu": "firebase emulators:exec --only auth,firestore --project app-from-ai \"vitest run src/lib/firestore_store.emu.test.ts mcp/mcp.emu.test.ts\"",
    "typecheck": "tsc -p . && tsc -p tsconfig.mcp.json",
    "mcp:web": "tsx mcp/chayWeb.ts",
    "deploy:rules": "firebase deploy --only firestore:quyphong --project app-from-ai"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "firebase": "^13.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
