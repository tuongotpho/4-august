# Điền cấu hình web app Firebase để bật đăng nhập Google + lưu Firestore.
# Để trống VITE_FIREBASE_API_KEY → app chạy chế độ lưu trong trình duyệt (localStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Tên database Firestore (để trống = (default))
VITE_FIREBASE_DATABASE_ID=quyphong
# Đặt =1 khi chạy với Firebase emulator
VITE_FIREBASE_EMULATOR=
